#!/usr/bin/env bash
# .codemender/scripts/pre-commit
# Official Google Cloud CodeMender (`cm`) + Semgrep Pre-Commit Hook
# Scans ONLY staged files for secrets (Semgrep) and CRITICAL/HIGH vulnerabilities (cm).
# Reference: https://docs.cloud.google.com/gemini-enterprise-agent-platform/agents/codemender/integrate-with-cicd#pre-commit-hook

set -euo pipefail

export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

MODEL="${CODEMENDER_MODEL:-gemini-3.8-flash}"

echo "==> [1/2] Semgrep Secrets Scan on staged files..."
# shellcheck disable=SC2086
semgrep scan --config=p/secrets --error --quiet -- $STAGED_FILES
echo "    ✅ Semgrep: 0 secrets detected in staged files."

# Only run CodeMender on code files if any are staged
STAGED_CODE_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|py|go|java|kt|c|cc|cpp|rs|rb|php)$' || true)
if [ -z "$STAGED_CODE_FILES" ]; then
  echo "✅ Pre-commit check passed (no source code files staged)."
  exit 0
fi

FIRST_STAGED_FILE=$(printf '%s\n' "$STAGED_CODE_FILES" | head -n 1)
SCAN_TARGET="."
if [ "$(printf '%s\n' "$STAGED_CODE_FILES" | wc -l)" -eq 1 ]; then
  SCAN_TARGET="./${FIRST_STAGED_FILE#./}"
fi

echo "==> [2/2] CodeMender Staged-Only Scan (cm find $SCAN_TARGET --diff --staged --model=$MODEL)..."
if ! cm find \
    --diff \
    --staged \
    --diff-workers=16 \
    --fail-on=CRITICAL,HIGH \
    --model="$MODEL" \
    --yes \
    --sandbox=false \
    --bypass-warning \
    -- "$SCAN_TARGET"; then
  echo "❌ CodeMender blocked this commit. To see the findings, run:" >&2
  echo "  cm report --status=OPEN" >&2
  echo "To verify and fix locally, run:" >&2
  echo "  cm verify <FINDING_ID> --model=gemini-4-argon" >&2
  echo "  cm fix <FINDING_ID> --model=gemini-4-argon" >&2
  echo "To commit anyway, run git commit --no-verify." >&2
  exit 1
fi

echo "✅ Pre-commit check passed fast on staged files!"
